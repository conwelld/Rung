# Hourly SQLite backups to S3, and a restore when an instance starts without a
# database. See "Backups" in AWS_DEPLOY.md.
#
# The single instance's disk survives deploys and reboots but not a
# replacement: a failed health check, a platform update, or a rebuilt
# environment all start from an empty disk. With these scripts the new instance
# starts from the last hourly backup instead of from nothing.
#
# Backups go to the bucket Elastic Beanstalk already created for this account
# and region, elasticbeanstalk-<region>-<account-id>, under rung-backups/. The
# default instance role (aws-elasticbeanstalk-ec2-role) can already read and
# write elasticbeanstalk-* buckets, so this needs no IAM change. The backups are
# student records: that bucket is private by default and has to stay that way.
#
# This file must keep Unix line endings. The scripts below are written out
# byte for byte, and bash refuses a script with Windows carriage returns.
files:
  "/usr/local/bin/rung-backup-location":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Sourced by rung-db-backup and rung-db-restore. Sets REGION and
      # BACKUP_URI from instance metadata (IMDSv2) and the account id.
      # RUNG_BACKUP_PREFIX separates two environments in one account and
      # region; set it with `eb setenv` if you ever run a second one.
      TOKEN=$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
      REGION=$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/placement/region)
      ACCOUNT=$(aws sts get-caller-identity --query Account --output text --region "$REGION")
      PREFIX=$(/opt/elasticbeanstalk/bin/get-config environment -k RUNG_BACKUP_PREFIX 2>/dev/null || true)
      case "$PREFIX" in
        ""|*[!A-Za-z0-9._/-]*) PREFIX=rung-backups ;;
      esac
      BACKUP_URI="s3://elasticbeanstalk-${REGION}-${ACCOUNT}/${PREFIX}"

  "/usr/local/bin/rung-db-backup":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Copy the live database to S3: latest.db.gz, plus one file per day.
      # Uses SQLite's online backup API, which takes a consistent snapshot of a
      # database in WAL mode. Copying the file directly while the app writes
      # to it can produce a corrupt copy.
      set -euo pipefail
      DB=/var/rung-data/rung.db
      [ -f "$DB" ] || exit 0
      source /usr/local/bin/rung-backup-location
      TMP=$(mktemp -d)
      trap 'rm -rf "$TMP"' EXIT
      python3 -c 'import sqlite3, sys
      src = sqlite3.connect(sys.argv[1]); dst = sqlite3.connect(sys.argv[2])
      src.backup(dst); dst.close(); src.close()' "$DB" "$TMP/rung.db"
      gzip "$TMP/rung.db"
      aws s3 cp "$TMP/rung.db.gz" "$BACKUP_URI/latest.db.gz" --region "$REGION" --only-show-errors
      aws s3 cp "$TMP/rung.db.gz" "$BACKUP_URI/daily/$(date -u +%F).db.gz" --region "$REGION" --only-show-errors

  "/usr/local/bin/rung-db-restore":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Put the latest backup in place when this instance has no database yet.
      # Never overwrites an existing database, and never fails a deploy: with
      # no usable backup the app creates a fresh, empty database on startup
      # exactly as it did before backups existed.
      set -uo pipefail
      DB=/var/rung-data/rung.db
      [ -f "$DB" ] && exit 0
      source /usr/local/bin/rung-backup-location || exit 0
      TMP=$(mktemp -d)
      trap 'rm -rf "$TMP"' EXIT
      if ! aws s3 cp "$BACKUP_URI/latest.db.gz" "$TMP/rung.db.gz" --region "$REGION" --only-show-errors; then
        echo "rung: no backup at $BACKUP_URI/latest.db.gz; starting with an empty database"
        exit 0
      fi
      gunzip "$TMP/rung.db.gz" || exit 0
      CHECK=$(python3 -c 'import sqlite3, sys
      print(sqlite3.connect(sys.argv[1]).execute("PRAGMA integrity_check").fetchone()[0])' "$TMP/rung.db")
      if [ "$CHECK" != "ok" ]; then
        echo "rung: backup failed its integrity check ($CHECK); not restoring"
        exit 0
      fi
      mkdir -p /var/rung-data
      install -o webapp -g webapp -m 0640 "$TMP/rung.db" "$DB"
      echo "rung: restored $DB from $BACKUP_URI/latest.db.gz"

  "/etc/cron.d/rung-db-backup":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Hourly database backup to S3. See .ebextensions/02-backups.config.
      17 * * * * root /usr/local/bin/rung-db-backup >> /var/log/rung-backup.log 2>&1

  # Include the backup log in `eb logs`, so a failing backup is visible
  # without SSH access to the instance.
  "/opt/elasticbeanstalk/tasks/taillogs.d/rung-backup.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/rung-backup.log

container_commands:
  # Runs before the new version starts serving. On an instance that already
  # has a database this is a no-op.
  01_restore_database:
    command: /usr/local/bin/rung-db-restore
    ignoreErrors: true
