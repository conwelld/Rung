# Elastic Beanstalk's own equivalent of render.yaml: non-secret configuration
# that belongs in the repository so a redeploy cannot quietly differ from what
# is written down. Secrets (RUNG_SECRET_KEY, ANTHROPIC_API_KEY,
# RUNG_ORIGIN_SECRET) are set with `eb setenv` instead, per AWS_DEPLOY.md,
# never committed here. Values set with `eb setenv` override these.
#
# /var/app/current is replaced wholesale on every deploy, so the SQLite file
# lives at /var/rung-data instead, on the instance's own root volume. That
# survives ordinary deploys and reboots. An instance replacement starts from
# the latest S3 backup instead; see 02-backups.config.
commands:
  01_create_rung_data_dir:
    command: "mkdir -p /var/rung-data && chown webapp:webapp /var/rung-data"

option_settings:
  aws:elasticbeanstalk:application:environment:
    RUNG_ENV: production
    RUNG_DB: /var/rung-data/rung.db
    # CloudFront, then this instance's nginx. Without this every student
    # appears to come from 127.0.0.1 and the per-IP start cap becomes one cap
    # for the whole class. See RUNG_PROXY_HOPS in rung/config.py.
    RUNG_PROXY_HOPS: "2"
    # Daily session caps reset at midnight in Berea rather than at UTC
    # midnight, which is 8pm Eastern for half the year.
    TZ: America/New_York
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
  # The Python platform's nginx serves /static itself, from a folder named
  # `static` at the bundle root. The app's static files live in public/static
  # (where Vercel's CDN also looks), so without this mapping every stylesheet
  # and the Python runner 404 in nginx before Flask ever sees the request.
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: public/static
